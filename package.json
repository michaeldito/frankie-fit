{
  "name": "frankie-fit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "start": "pnpm --dir apps/web start",
    "lint": "eslint . && pnpm --dir apps/web lint",
    "typecheck": "tsc --noEmit && pnpm --dir apps/web typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval:intelligence": "node --no-warnings scripts/eval-intelligence.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "seed:demo:dry": "node scripts/seed-demo-data.mjs --dry-run",
    "reset:user": "node scripts/reset-user-data.mjs",
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "lint:web": "pnpm --dir apps/web lint",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "ios:mobile": "pnpm --dir apps/mobile ios",
    "ios:mobile:dev": "pnpm --dir apps/mobile ios:dev",
    "ios:mobile:simulator": "pnpm --dir apps/mobile ios:simulator",
    "android:mobile": "pnpm --dir apps/mobile android",
    "web:mobile": "pnpm --dir apps/mobile web",
    "lint:mobile": "pnpm --dir apps/mobile lint"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
